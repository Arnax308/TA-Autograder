# Copy this file to .env and fill in what you use. .env is git-ignored: never commit real keys.

# ---- AI assistant (writes the TA test drivers; optional code review). Pick one provider.
# auto = Groq if only GROQ_API_KEY is set, otherwise Gemini
LLM_PROVIDER=auto
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TPM_LIMIT=8000          # tokens/minute per model on your Groq plan (free tier is ~8000)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# The AI code review (Comp 1/3/4) costs many tokens. "off" uses code metrics for style/comments instead.
LLM_REVIEW=off

# ---- Which students to grade (empty = everyone). Ranges or single roll numbers.
# TA_STUDENTS=cs25b1089-cs25b1103, cs25b2001-cs25b2008
TA_STUDENTS=

# ---- Where student code is compiled and run: auto (default; WSL when it has gcc), wsl, or native
EXEC_BACKEND=auto
# Optional compiler overrides for the native backend
# GCC_PATH=C:/w64devkit/bin/gcc.exe
# GXX_PATH=C:/w64devkit/bin/g++.exe

# Dashboard port (default 8765)
# TA_GUI_PORT=8765
